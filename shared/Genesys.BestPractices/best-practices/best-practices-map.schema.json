{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Best Practices Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_on",
    "mappings"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_type",
          "best_practice_keys",
          "default_severity",
          "recommended_action_short"
        ],
        "properties": {
          "finding_type": {
            "type": "string"
          },
          "best_practice_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "default_severity": {
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          "recommended_action_short": {
            "type": "string"
          }
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genesys Best Practices Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_on",
    "catalog_name",
    "domains",
    "catalog"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "catalog_name": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "enum": [
          "Queue",
          "API",
          "EdgeSite",
          "Architect",
          "Security",
          "Telephony",
          "DevOps"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "domain",
          "subcategory",
          "control_family",
          "pillar",
          "report_category",
          "title",
          "summary",
          "why_it_matters",
          "recommended_state",
          "anti_pattern",
          "severity",
          "auditability",
          "tags",
          "object_types",
          "source_basis",
          "source_refs",
          "source_notes",
          "source_urls",
          "last_verified",
          "detection_strategy",
          "required_inputs",
          "logic_hint",
          "automatable",
          "recommended_action_short",
          "recommended_action_detailed",
          "remediation_priority",
          "rollback_considerations",
          "evidence_examples",
          "sample_bad_state",
          "sample_good_state",
          "owner_role",
          "owner_team",
          "review_cadence",
          "false_positive_notes",
          "exceptions",
          "risk_acceptance_allowed",
          "status",
          "introduced_in_version",
          "review_status"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
          },
          "domain": {
            "enum": [
              "Queue",
              "API",
              "EdgeSite",
              "Architect",
              "Security",
              "Telephony",
              "DevOps"
            ]
          },
          "subcategory": {
            "type": "string"
          },
          "control_family": {
            "type": "string"
          },
          "pillar": {
            "type": "string"
          },
          "report_category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "recommended_state": {
            "type": "string"
          },
          "anti_pattern": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          "auditability": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "object_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_basis": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_notes": {
            "type": "string"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "detection_strategy": {
            "type": "string"
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "logic_hint": {
            "type": "string"
          },
          "automatable": {
            "type": "boolean"
          },
          "recommended_action_short": {
            "type": "string"
          },
          "recommended_action_detailed": {
            "type": "string"
          },
          "remediation_priority": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "rollback_considerations": {
            "type": "string"
          },
          "evidence_examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sample_bad_state": {
            "type": "string"
          },
          "sample_good_state": {
            "type": "string"
          },
          "owner_role": {
            "type": "string"
          },
          "owner_team": {
            "type": "string"
          },
          "review_cadence": {
            "type": "string"
          },
          "false_positive_notes": {
            "type": "string"
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_acceptance_allowed": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "deprecated"
            ]
          },
          "introduced_in_version": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
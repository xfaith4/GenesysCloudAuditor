<UserControl x:Class="GenesysExtensionAudit.Views.RunAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GenesysExtensionAudit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:RunAuditViewModel}}"
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720">

            <!-- ─── Title ─── -->
            <TextBlock Text="Run Audit"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20" />

            <!-- ─── Configuration ─── -->
            <GroupBox Header="Configuration" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Page Size"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                        <TextBox Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 HorizontalAlignment="Left" />
                        <TextBlock Text="Number of records per API page (1–500). Default: 100."
                                   Foreground="#6B7280" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Include Inactive Users"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Row="2" Grid.Column="1"
                              IsChecked="{Binding IncludeInactive}"
                              VerticalAlignment="Center"
                              Content="Include users with state = inactive" />

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="Operational Lookback Days"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical">
                        <TextBox Text="{Binding OperationalEventLookbackDays, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 HorizontalAlignment="Left" />
                        <TextBlock Text="Used by Operational Event Logs. Default: 7 days."
                                   Foreground="#6B7280" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ─── Audit Paths ─── -->
            <GroupBox Header="Audit Paths" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Select All"
                              IsChecked="{Binding SelectAllAudits}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" />

                    <WrapPanel>
                        <CheckBox Content="Extensions"
                                  IsChecked="{Binding RunExtensionAudit}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="Groups"
                                  IsChecked="{Binding RunGroupAudit}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="Queues"
                                  IsChecked="{Binding RunQueueAudit}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="Flows"
                                  IsChecked="{Binding RunFlowAudit}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="Inactive Users"
                                  IsChecked="{Binding RunInactiveUserAudit}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="DIDs"
                                  IsChecked="{Binding RunDidAudit}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="Audit Logs"
                                  IsChecked="{Binding RunAuditLogs}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="Operational Event Logs"
                                  IsChecked="{Binding RunOperationalEventLogs}"
                                  Margin="0,0,18,8" />
                        <CheckBox Content="OutboundEvents"
                                  IsChecked="{Binding RunOutboundEvents}"
                                  Margin="0,0,18,8" />
                    </WrapPanel>

                    <TextBlock Text="Choose one or more paths to run in this audit pass."
                               Foreground="#6B7280"
                               FontSize="11" />

                    <!-- ─── Audit Logs configuration (visible when RunAuditLogs checked) ─── -->
                    <Border Margin="0,10,0,0" Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding RunAuditLogs, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Audit Logs Options" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                            <!-- Row 1: Lookback + Service -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Lookback (hours)" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <TextBox Width="80" Text="{Binding AuditLogLookbackHours, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Service" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="220"
                                                  ItemsSource="{Binding AuditLogEntities}"
                                                  SelectedItem="{Binding SelectedAuditLogEntity}"
                                                  IsEnabled="{Binding IsAuditLogSelectionEnabled}" />
                                        <Button Content="↻"
                                                Command="{Binding RefreshAuditCatalogCommand}"
                                                ToolTip="Reload service catalog"
                                                Margin="6,0,0,0"
                                                Padding="8,2" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Sort Order" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <ComboBox Width="130"
                                              ItemsSource="{Binding AuditLogSortOrders}"
                                              SelectedItem="{Binding SelectedAuditLogSortOrder}" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Action + Entity Type filters -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Action filter" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <ComboBox Width="180"
                                              ItemsSource="{Binding AuditLogActions}"
                                              SelectedItem="{Binding SelectedAuditLogAction}"
                                              IsEnabled="{Binding IsAuditLogSelectionEnabled}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Entity Type filter" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <ComboBox Width="200"
                                              ItemsSource="{Binding AuditLogEntityTypes}"
                                              SelectedItem="{Binding SelectedAuditLogEntityType}"
                                              IsEnabled="{Binding IsAuditLogSelectionEnabled}" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: ID filters -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="User ID (optional)" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <TextBox Width="260"
                                             Text="{Binding AuditLogUserIdFilter, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsAuditLogSelectionEnabled}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Entity ID (optional)" FontSize="11" Foreground="#374151" Margin="0,0,0,4" />
                                    <TextBox Width="260"
                                             Text="{Binding AuditLogEntityIdFilter, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsAuditLogSelectionEnabled}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"
                                       Text="Action and Entity Type dropdowns populate after selecting a Service. User ID and Entity ID accept GUIDs. All filters are ANDed together." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- ─── Actions ─── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="▶  Start Audit"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"
                        Padding="16,8"
                        Margin="0,0,10,0"
                        Background="#1D4ED8"
                        Foreground="White"
                        FontWeight="SemiBold" />

                <Button Content="⏹  Cancel"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding CanCancel}"
                        Padding="16,8"
                        Margin="0,0,10,0" />

                <Button Content="Export Last Report..."
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding HasReport}"
                        Padding="16,8" />
            </StackPanel>

            <!-- ─── Export Options ─── -->
            <GroupBox Header="Export Options" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Workbook Mode"
                                   Width="120"
                                   VerticalAlignment="Center" />
                        <ComboBox Width="180"
                                  ItemsSource="{Binding WorkbookExportModes}"
                                  SelectedItem="{Binding SelectedWorkbookExportMode}" />
                    </StackPanel>
                    <TextBlock Foreground="#6B7280"
                               FontSize="11"
                               Margin="0,0,0,8"
                               Text="Consolidated: one workbook. Separate: one workbook per selected audit path." />
                    <CheckBox Content="Push to GitHub after saving"
                              IsChecked="{Binding PushToGitHub}"
                              IsEnabled="{Binding IsGitHubConfigured}"
                              Margin="0,0,0,4" />
                    <CheckBox Content="Export normalized findings to Elastic after saving"
                              IsChecked="{Binding PushToElasticSearch}"
                              IsEnabled="{Binding IsElasticConfigured}"
                              Margin="0,0,0,4" />
                    <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGitHubConfigured}" Value="True">
                                        <Setter Property="Text"
                                                Value="The report will be saved locally first, then pushed to the configured GitHub repository. Enable 'Create draft PR' in Settings to open a pull request instead of committing directly." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGitHubConfigured}" Value="False">
                                        <Setter Property="Text"
                                                Value="GitHub push is disabled. Go to the Settings tab to configure your repository and personal access token." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElasticConfigured}" Value="True">
                                        <Setter Property="Text"
                                                Value="Elastic export uses the endpoint, index, and token environment variable configured in Settings. The token itself is never stored in the app." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsElasticConfigured}" Value="False">
                                        <Setter Property="Text"
                                                Value="Elastic export is disabled. Go to the Settings tab to configure the endpoint, target index, and token environment variable name." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- ─── Progress ─── -->
            <GroupBox Header="Progress" Padding="12" Margin="0,0,0,16"
                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Height="16"
                                 Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                               HorizontalAlignment="Right"
                               Foreground="#374151"
                               FontSize="12"
                               Margin="0,-4,0,6" />
                    <TextBlock Text="{Binding ProgressMessage}"
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!-- ─── Status ─── -->
            <Border Background="#F3F4F6" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#374151" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#374151" />
                </StackPanel>
            </Border>

            <GroupBox Header="Last Run Summary"
                      Padding="12"
                      Margin="0,0,0,12"
                      Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding LastRunSummary}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Audit Path" Binding="{Binding AuditPath}" Width="2*" />
                        <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Best Practice Guidance"
                      Padding="12"
                      Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding BestPracticesStatusSummary}"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BestPracticesStatusDetails}"
                               Foreground="#6B7280"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding UnmappedBestPracticeFindingTypesSummary}"
                               Foreground="#92400E"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasUnmappedBestPracticeFindingTypes, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid ItemsSource="{Binding BestPracticeGuidance}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              Visibility="{Binding HasBestPracticeGuidance, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding SourceDomain}" Width="*" />
                            <DataGridTextColumn Header="Object" Binding="{Binding SourceObjectName}" Width="*" />
                            <DataGridTextColumn Header="Best Practice" Binding="{Binding BestPracticeTitlesDisplay}" Width="2*" />
                            <DataGridTextColumn Header="Why It Matters" Binding="{Binding WhyItMatters}" Width="2*" />
                            <DataGridTextColumn Header="Recommended Action" Binding="{Binding RecommendedActionShort}" Width="2*" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <!-- ─── Error ─── -->
            <Border Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Error" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

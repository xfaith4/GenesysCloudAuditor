{
  "Genesys": {
    "Region": "usw2.pure.cloud",
    "PageSize": 100,
    "IncludeInactive": false,
    "MaxRequestsPerSecond": 3
  },

  "GenesysOAuth": {
    "AuthMode": "auto",
    "ClientId": "",
    "ClientSecret": "",
    "PkceClientId": "",
    "PkceRedirectUri": "http://127.0.0.1:45731/callback",
    "PkceScope": "users:readonly telephony:readonly groups:readonly routing:readonly architect:readonly outbound:readonly"
  },

  "Audit": {
    "StaleFlowThresholdDays": 90,
    "InactiveUserThresholdDays": 90,
    "IncludeInactiveUsers": false,
    "RunOperationalEventLogs": false,
    "OperationalEventLookbackDays": 7,
    "RunOutboundEvents": false
  },

  "Export": {
    "OutputDirectory": "reports",
    "FilePrefix": "GenesysAudit"
  },

  "SharePoint": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "SiteUrl": "",
    "FolderPath": "Shared Documents/GenesysAudit"
  },

  "GitHub": {
    "Token": "",
    "Owner": "",
    "Repository": "",
    "Branch": "main",
    "FolderPath": "audit-reports",
    "CommitMessage": "chore: add audit report {fileName}"
  },

  "ElasticExport": {
    "Enabled": false,
    "EndpointUri": "",
    "IndexName": "genesys-audit-findings",
    "TokenEnvironmentVariableName": "GENESYS_AUDIT_ELASTIC_TOKEN",
    "IncludeRunSummaryDocument": true,
    "BulkBatchSize": 250
  },

  "BestPractices": {
    "RootPath": "..\\..\\..\\..\\shared\\Genesys.BestPractices",
    "CatalogPath": "best-practices\\best-practices.catalog.json",
    "CatalogSchemaPath": "best-practices\\best-practices.schema.json",
    "MapPath": "best-practices\\best-practices-map.json",
    "MapSchemaPath": "best-practices\\best-practices-map.schema.json",
    "GlossaryPath": "best-practices\\glossary.json",
    "FailOnValidationError": false
  },

  "Scheduling": {
    "TaskFolderPath": "\\GenesysExtensionAudit\\",
    "TaskNamePrefix": "GenesysExtensionAudit_",
    "RunnerExecutablePath": ""
  },

  "Logging": {
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": true,
    "FileMinimumLevel": "Information",
    "LogDirectory": "logs",
    "RetainedFileCount": 8,
    "MaxFileSizeMb": 20,
    "RetainedDays": 8,
    "EnableSerilogSelfLog": false
  }
}
